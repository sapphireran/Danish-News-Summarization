{
  "name": "mt5-large-silver-labels",
  "comment": "Hyperparameters copied from finetune.py so they can be reviewed as data.",
  "model_name": "google/mt5-large",
  "output_dir": "mt5-summarize-large",
  "final_save_dir": "large_model",
  "eval_scripts_expect": "small_model",
  "data": {
    "train": "datasets/train_dataset.csv",
    "validation": "datasets/validation_dataset.csv",
    "test": "datasets/test_dataset.csv",
    "text_column": "body",
    "summary_column": "summary",
    "max_source_length": 1024,
    "max_target_length": 128
  },
  "generation_config": {
    "min_length": 9,
    "max_length": 128,
    "length_penalty": 0.8,
    "no_repeat_ngram_size": 3,
    "num_beams": 4,
    "dropout_rate": 0.1
  },
  "training": {
    "num_train_epochs": 20,
    "learning_rate": 0.0003,
    "lr_scheduler_type": "polynomial",
    "warmup_steps": 1000,
    "optim": "adafactor",
    "weight_decay": 0.01,
    "per_device_train_batch_size": 8,
    "per_device_eval_batch_size": 8,
    "gradient_accumulation_steps": 1,
    "evaluation_strategy": "epoch",
    "save_strategy": "epoch",
    "predict_with_generate": true,
    "generation_max_length": 128,
    "logging_steps": 250,
    "push_to_hub": false,
    "fp16": true,
    "load_best_model_at_end": true,
    "metric_for_best_model": "rouge_1_mid_fmeasure",
    "save_total_limit": 1
  },
  "personal_rerun_notes": [
    "Set fp16 to false on CPU.",
    "Shrink warmup_steps if the train CSV is much smaller than 8k rows.",
    "Point eval scripts at final_save_dir or copy large_model to small_model.",
    "datasets.load_metric is deprecated; plan a move to evaluate.load."
  ]
}
